# ============================================================
# BJ SERVICES: SUPABASE ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and replace with your Supabase keys
# ============================================================

# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key for backend administrative operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL for OAuth redirects (http://localhost:3000 in dev, your production domain in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
